# Example Terraform Variables for ElectronicLive

location        = "uksouth"
environment     = "prod"
app_name        = "electroniclive"
container_image = "ghcr.io/foysal94/electroniclive/electroniclive-api:latest"
min_replicas    = 0
max_replicas    = 1
cpu             = 0.25
memory          = "0.5Gi"

# Pass API keys and connection strings (or inject via environment variables TF_VAR_* in CI)
# skiddle_api_key      = "your-skiddle-key"
# ticketmaster_api_key = "your-ticketmaster-key"
# db_connection_string = "Host=ep-xyz.eu-central-1.aws.neon.tech;Database=neondb;Username=...;Password=...;SSL Mode=Require;Trust Server Certificate=true"
# resend_api_key       = "re_123456789"

