{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=electroniclive;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "EventProviders": {
    "Ticketmaster": {
      "BaseUrl": "https://app.ticketmaster.com/discovery/v2/",
