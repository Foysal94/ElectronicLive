    "ResidentAdvisor": {
      "BaseUrl": "https://ra.co/",
      "Limit": 50
    }
  },
  "Cache": {
    "ExpirationMinutes": 30
  },
  "Resend": {
    "BaseUrl": "https://api.resend.com/",
    "ApiKey": "",
    "FromEmail": "ElectronicLive <alerts@electroniclive.co.uk>"
  },
  "Scanner": {
    "BaseUrl": "https://electroniclive.co.uk",
    "DelayBetweenArtistsMs": 300
  },
  "AllowedHosts": "*"
